{
  "name": "@elizaos/plugin-agent-orchestrator",
  "version": "0.3.19",
  "description": "Coding agent orchestration plugin - spawn and manage CLI coding agents via PTY",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node ./scripts/ensure-node-pty.mjs",
    "build": "bun run build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elizaos/core": ">=2.0.0-alpha.0",
    "git-workspace-service": "0.4.4",
    "pty-manager": "1.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "coding-agent-adapters": "0.12.0",
    "pty-console": "0.3.1"
  }
}
